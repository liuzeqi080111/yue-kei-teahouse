# Node 24+. Copy to .env and fill in your mainland Bailian workspace configuration.
# Never put the key in frontend files or commit .env.
DASHSCOPE_API_KEY=
BAILIAN_OPENAI_BASE_URL=https://YOUR-WORKSPACE.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
PORT=4173
# Optional server-only Azure Speech resource for Cantonese practice scoring.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
